{
  // Use these configurations to run the app or a single test with the JVM options
  // needed to allow TestFX reflection into JavaFX internals.
  "version": "0.2.0",
  "configurations": [
    {
        "type": "java",
        "name": "Launch HelloWorld (JavaFX flags)",
        "request": "launch",
        "mainClass": "app.HelloWorld",
        "projectName": "",
        "vmArgs": "--add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED --module-path \"C:\\path\\to\\javafx-sdk\\lib\" --add-modules=javafx.controls,javafx.graphics"
    },
    {
        "type": "java",
        "name": "Run single test: StudentTest (with JavaFX flags)",
        "request": "launch",
        "mainClass": "org.junit.runner.JUnitCore",
        "args": "app.StudentTest",
        "projectName": "",
        "vmArgs": "--add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED --add-exports=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED --module-path \"C:\\path\\to\\javafx-sdk\\lib\" --add-modules=javafx.controls,javafx.graphics"
    },
    {
        "type": "java",
        "name": "GameEngine",
        "request": "launch",
        "mainClass": "app.HelloWorld",
        "projectName": "",
        "linux": {
        "vmArgs": "--module-path ${env:JAVAFX_JMODS}:${env:JAVAFX_HOME}/lib --add-modules javafx.controls,javafx.graphics,javafx.base --enable-native-access=javafx.graphics",
        "env": {
            "DISPLAY": ":1"
        }
        }
    },
    {
        "type": "java",
        "name": "Run Jar File",
        "request": "launch",
        "mainClass": "app.HelloWorld",
        "classPaths": [
        "${workspaceFolder}/workspaces/apt-final-project-v2-gaganab-sreshtan-aadib/apt-final-project-v2-gaganab-sreshtan-aadib.jar"
        ],
        "projectName": ""
    }
  ]
}
