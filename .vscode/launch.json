{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "openaiApiKey",
            "type": "promptString",
            "description": "OpenAI API key",
            "password": true
        }
    ],
    "configurations": [
        {
            "type": "java",
            "name": "GameEngine",
            "request": "launch",
            "mainClass": "app.HelloWorld",
            "projectName": "",
            "vmArgs": "--module-path \"${workspaceFolder}/javafx-sdk-25/lib\" --add-modules javafx.controls,javafx.graphics,javafx.base --enable-native-access=javafx.graphics",
            "env": {
                "OPENAI_API_KEY": "${input:openaiApiKey}",
                "OPENAI_MODEL": "${env:OPENAI_MODEL}"
            },
            "linux": {
                "vmArgs": "--module-path ${env:JAVAFX_JMODS}:${env:JAVAFX_HOME}/lib --add-modules javafx.controls,javafx.graphics,javafx.base --enable-native-access=javafx.graphics",
                "env": {
                    "DISPLAY": ":1"
                }
            }

        },
        {
            "type": "java",
            "name": "Run Jar File",
            "request": "launch",
            "mainClass": "app.HelloWorld",
            "classPaths": [
                "${workspaceFolder}/apt-final-project-v2-gaganab-sreshtan-aadib.jar"
            ],
            "projectName": "",
            "vmArgs": "--module-path \"${workspaceFolder}/javafx-sdk-25/lib\" --add-modules javafx.controls,javafx.graphics,javafx.base --enable-native-access=javafx.graphics",
            "env": {
                "OPENAI_API_KEY": "${input:openaiApiKey}",
                "OPENAI_MODEL": "${env:OPENAI_MODEL}"
            },
            // "linux": {
            //     "vmArgs": "--module-path ${env:JAVAFX_JMODS}:${env:JAVAFX_HOME}/lib --add-modules javafx.controls,javafx.graphics,javafx.base --enable-native-access=javafx.graphics",
            //     "env": {
            //         "DISPLAY": ":1"
            //     }
            // }
        }
    ]
}
